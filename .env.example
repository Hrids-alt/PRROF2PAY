# Copy to .env.local and fill in. Never commit real secrets.

# Postgres (must outlast Dec 15; Render free Postgres expires in 30 days)
DATABASE_URL=postgres://user:password@localhost:5432/proof2pay

# Where this app is reachable. PayPal sends the client back here after they approve.
APP_URL=http://localhost:3000

# Signs the sign-in cookie and the view-only preview links. Any long random string.
SESSION_SECRET=change-me-to-a-long-random-string

# PayPal sandbox (REST app credentials + webhook id from the developer dashboard).
# Use a US-based sandbox platform account: India-based accounts cannot take USD.
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# AI model for verdicts and check drafting (Anthropic Messages API). Without a key the
# document checks say "needs a person" and drafting uses simple rules.
AI_API_KEY=
AI_MODEL=claude-sonnet-5-5
# AI_BASE_URL=https://api.anthropic.com

# Optional: a GitHub token raises the API rate limit for repo checks (public repos only).
GITHUB_TOKEN=

# Demo helpers. DEMO_MODE shows buttons that move deadlines and decide held reviews, for the video.
DEMO_MODE=false
# Set to false to switch off the pick-an-account sign-in.
DEMO_LOGIN=true

# Background loop (deadlines, re-authorize, stuck work, lost-webhook reconcile).
TICK_SECONDS=30
# DISABLE_TICK=true
# Optional: lets a cron service ping POST /api/tick with "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=

# Scripted browser checks need the optional `playwright` package and a browser on the server.
ENABLE_BROWSER_CHECKS=false
